# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.pytest_cache/

# Virtual envs
.venv/

# Generated reports
rail-coverage/output/
tile-sharpness/out/
tile-sharpness/out_*/
tile-sharpness/cross_cohort_summary/

# POC output directories (large, regenerable)
tile-sharpness/scripts/poc_pad_grid_fft_out/
tile-sharpness/scripts/poc_subpixel_binning_out/
tile-sharpness/scripts/poc_wide_feature_inventory_out/

# poc_comb_chain: commit scripts + REPORT + small result CSVs/histograms;
# ignore heavy regenerable artifacts (bulk CSVs + multi-MB image crops)
tile-sharpness/scripts/poc_comb_chain_out/a1_all.csv
tile-sharpness/scripts/poc_comb_chain_out/a1_shard_*.csv
tile-sharpness/scripts/poc_comb_chain_out/contrast_inspect/*__roi.png
tile-sharpness/scripts/poc_comb_chain_out/contrast_inspect/view_*.png
tile-sharpness/scripts/poc_comb_chain_out/contrast_inspect/padpop/*cellmode_map.png
# Stage T_n (saturation-channel re-extraction): heavy regenerable artifacts
tile-sharpness/scripts/poc_comb_chain_out/tn_all.csv
tile-sharpness/scripts/poc_comb_chain_out/tn_shard_*.csv
tile-sharpness/scripts/poc_comb_chain_out/tn_shard_*.log
tile-sharpness/scripts/poc_comb_chain_out/tn_run.log
# Stage Targets (wide periodic-target survey): commit small result CSVs + run log,
# ignore the heavy 2D-FFT magnitude PNG dump (regenerable from phase1).
tile-sharpness/scripts/poc_comb_chain_out/targets/fft2d/
# Stage Relock (feature-locking audit + re-anchored re-extraction): commit small result
# CSVs (phaseA_audit, phaseB_collapse) + run logs; ignore the bulk re-extracted comb CSV,
# the shards, and the 2D-FFT PNG dump (all regenerable from the relock scripts).
tile-sharpness/scripts/poc_comb_chain_out/relock/relock_all.csv
tile-sharpness/scripts/poc_comb_chain_out/relock/relock_shard_*.csv
tile-sharpness/scripts/poc_comb_chain_out/relock/relock_shard_*.log
tile-sharpness/scripts/poc_comb_chain_out/relock/fft2d/
# Stage Preproc (linear pre-processing cause-isolation): commit the small ablation summary
# CSV (preproc_ablation.csv); ignore the per-arm bulk comb CSVs, shards, and run logs.
tile-sharpness/scripts/poc_comb_chain_out/preproc/*_all.csv
tile-sharpness/scripts/poc_comb_chain_out/preproc/*_shard_*.csv
tile-sharpness/scripts/poc_comb_chain_out/preproc/*_shard_*.log
tile-sharpness/scripts/poc_comb_chain_out/preproc/run.log

# Stage AltEst (non-comb cross-M estimators): commit the small result/summary CSVs +
# the REPORT; ignore the resampled patch arrays, per-shard bulk CSVs, logs, and PNGs.
tile-sharpness/scripts/poc_comb_chain_out/altest/patches/
tile-sharpness/scripts/poc_comb_chain_out/altest/*_shard_*.csv
tile-sharpness/scripts/poc_comb_chain_out/altest/*_shard_*.log
tile-sharpness/scripts/poc_comb_chain_out/altest/*.log
tile-sharpness/scripts/poc_comb_chain_out/altest/smoke_*.png

# Stage AltEst-2 (hardening + variants): same policy — commit small result CSVs + the
# REPORT; ignore the resampled patch arrays, per-shard bulk CSVs, and logs.
tile-sharpness/scripts/poc_comb_chain_out/altest2/patches/
tile-sharpness/scripts/poc_comb_chain_out/altest2/*_shard_*.csv
tile-sharpness/scripts/poc_comb_chain_out/altest2/*_shard_*.log
tile-sharpness/scripts/poc_comb_chain_out/altest2/*.log
